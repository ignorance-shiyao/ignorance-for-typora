{
  "id": "ignorance.vault-probe",
  "name": "Ignorance Vault 验证",
  "version": "0.1.0",
  "engines": { "typora": ">=2.0.0" },
  "main": "main.js",
  "permissions": { "workspace": "read", "document": "read" },
  "contributes": {
    "commands": [
      { "id": "probe-storage", "title": "验证工作区扩展存储", "category": "工作区验证" },
      { "id": "probe-scan", "title": "测量工作区扫描", "category": "工作区验证" }
    ],
    "detailViews": [
      { "id": "probe-detail", "title": "存储验证", "entry": "views/detail.html" }
    ],
    "fenceRenderers": [
      { "id": "probe-static", "lang": ["vault-probe-static"], "mode": "static", "resolver": true },
      { "id": "probe-interactive", "lang": ["vault-probe-link"], "mode": "interactive", "resolver": true }
    ]
  }
}
