{
  "id": "ignorance.vault",
  "name": "Ignorance Vault",
  "version": "0.1.0",
  "description": "工作区笔记索引、属性查询和导航。",
  "author": "Ignorance",
  "tags": ["Markdown Extension", "Productivity"],
  "engines": { "typora": ">=2.0.0" },
  "main": "main.js",
  "activationEvents": ["onStartupFinished", "onCommand:rebuild-index", "onFence:query", "onFence:tasks", "onFence:track", "onCommand:search-workspace"],
  "permissions": { "workspace": "read", "document": "read" },
  "contributes": {
    "commands": [
      { "id": "rebuild-index", "title": "重建索引", "category": "工作区" },
      { "id": "search-workspace", "title": "搜索工作区", "category": "工作区" }
    ],
    "fenceRenderers": [
      { "id": "query", "lang": ["query"], "mode": "interactive", "resolver": true },
      { "id": "tasks", "lang": ["tasks"], "mode": "interactive", "resolver": true },
      { "id": "track", "lang": ["track"], "mode": "interactive", "resolver": true }
    ],
    "detailViews": [
      { "id": "week", "title": "本周任务", "icon": "list-checks", "entry": "views/week.html" },
      { "id": "search", "title": "工作区搜索", "icon": "search", "entry": "views/search.html" },
      { "id": "relations", "title": "关系", "icon": "network", "entry": "views/relations.html" },
      { "id": "review", "title": "复习", "icon": "layers", "entry": "views/review.html" }
    ],
    "configuration": {
      "title": "Ignorance Vault",
      "properties": {
        "excludeFolders": { "type": "string", "title": "排除目录", "default": "templates/, archive/" },
        "reviewReminders": { "type": "boolean", "title": "提醒复习到期卡片", "default": true }
      }
    }
  }
}
