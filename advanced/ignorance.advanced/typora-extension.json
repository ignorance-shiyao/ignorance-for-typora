    "detailViews": [
      {
        "id": "figures",
        "title": "图表与图片",
        "icon": "chart",
        "sfSymbol": "chart.bar.doc.horizontal",
        "query": {
          "block": [
            "fences",
            "table",
            "math_block"
          ],
          "inline": [
            "image"
          ]
        },
        "item": {
          "label": "{type} {lang} {text}",
          "groupBy": "heading"
        }
      },
      {
        "id": "slides",
        "title": "演示",
        "icon": "image-play",
        "sfSymbol": "play.rectangle",
        "entry": "slides/index.html"
      }
    ],
    "templates": "templates",
    "snippets": "snippets",
    "configuration": {
      "title": "Ignorance Advanced",
      "properties": {
        "showMascot": {
          "type": "boolean",
          "default": false,
          "title": "在演示里显示双猫",
          "description": "封面右下角和最后一页。主题里的双猫在 设置 ▸ 视图 ▸ 主题选项「双猫」单独开关，默认都关闭。"
        }
      }
    }
